{
  "format_version": "1.8.0",
  "animations": {
    "animation.labo_nether_boat.body_turn": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            "0.0",
            "query.body_y_rotation",
            "0.0"
          ]
        }
      }
    },
    "animation.labo_nether_boat.paddles": {
      "loop": true,
      "bones": {
        "left_paddle": {
          "rotation": [
            "math.max(query.is_moving, variable.labo_motion) * math.sin(query.life_time * 720.0) * 18.0",
            "math.max(query.is_moving, variable.labo_motion) * math.sin(query.life_time * 720.0) * 34.0",
            "math.max(query.is_moving, variable.labo_motion) * math.cos(query.life_time * 720.0) * 22.0"
          ]
        },
        "right_paddle": {
          "rotation": [
            "math.max(query.is_moving, variable.labo_motion) * math.sin(query.life_time * 720.0 + 180.0) * 18.0",
            "math.max(query.is_moving, variable.labo_motion) * math.sin(query.life_time * 720.0 + 180.0) * 34.0",
            "-math.max(query.is_moving, variable.labo_motion) * math.cos(query.life_time * 720.0 + 180.0) * 22.0"
          ]
        }
      }
    },
    "animation.labo_nether_boat.hurt": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            "query.property('labo:hurt') ? math.sin(query.life_time * 1800.0) * 3.0 : 0.0",
            "0.0",
            "query.property('labo:hurt') ? math.sin(query.life_time * 1800.0) * 9.0 : 0.0"
          ],
          "position": [
            "0.0",
            "query.property('labo:hurt') ? math.abs(math.sin(query.life_time * 1800.0)) * 0.55 : 0.0",
            "0.0"
          ]
        }
      }
    }
  }
}

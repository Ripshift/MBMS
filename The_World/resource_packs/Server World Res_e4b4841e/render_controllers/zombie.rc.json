{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.bt.zombie": {
      "arrays": {
        "textures": {
          "Array.skin": [
            "Texture.sunny",
            "Texture.makena",
            "Texture.alex",
            "Texture.steve",
            "Texture.zuri",
            "Texture.zombie",
            "Texture.redhanded",
            "Texture.possesed",
            "Texture.headshot",
            "Texture.gore",
            "Texture.corpse"
          ],
          "Array.skin_baby": [
            "Texture.sunny_baby",
            "Texture.makena_baby",
            "Texture.alex_baby",
            "Texture.steve_baby",
            "Texture.zuri_baby"
          ]
        }
      },
      "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? Array.skin_baby[v.zombie_baby_skin] : Array.skin[v.zombie_skin]"
      ]
    }
  }
}
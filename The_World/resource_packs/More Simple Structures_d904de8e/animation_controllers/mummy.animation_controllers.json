
{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.coreblockstudios_mss.mummy.move": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						{
							"move": "query.modified_move_speed * !query.is_baby"
						},
						{
							"move_baby": "query.modified_move_speed * query.is_baby"
						},
						{
							"bob": "query.is_alive&&!query.is_emerging"
						}
					],
					"transitions": [
						{
							"spawn": "query.is_emerging"
						},
						{
							"has_target": "query.has_target&&!query.is_emerging"
						}
					],
					"blend_transition": 0.1
				},
				"spawn": {
					"animations": [
					{
							"spawn": "!query.is_baby"
						},
						{
							"spawn_baby": "query.is_baby"
						}
					],
					"transitions": [
						{
							"default": "!query.is_emerging"
						}
					],
					"blend_transition": 0.1
				},
				"has_target": {
					"animations": [
						{
              "zombie_attack_bare_hand": "!query.is_baby || !query.is_item_equipped(0)"
            },
            {
              "baby_zombie_attack_bare_hand": "query.is_baby && query.is_item_equipped(0)"
            },
						{
							"move": "query.modified_move_speed * !query.is_baby"
						},
						{
							"move_baby": "query.modified_move_speed * query.is_baby"
						},
						{
							"bob": "query.is_alive&&!query.is_emerging"
						}
					],
					"transitions": [
						{
							"spawn": "query.is_emerging"
						},
						{
							"default": "!query.has_target"
						}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}
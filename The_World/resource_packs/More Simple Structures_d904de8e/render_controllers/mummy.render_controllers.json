{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.coreblockstudios_mss.mummy": {
			"arrays": {
				"textures": {
					"Array.base": [
					"Texture.default",
					"Texture.summoned"
					],
					"Array.baby": [
					"Texture.baby",
					"Texture.baby_summoned"
					]
				}
			},
			"geometry": "query.is_baby ? Geometry.baby : Geometry.default",
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"textures": [
				"query.is_baby ? Array.baby[query.mark_variant] : Array.base[query.mark_variant]"
			]
		}
	}
}
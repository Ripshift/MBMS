    "wypnt_mss:queen_spider_set_component_by_difficulty": {
        "sequence": [
            {
                "filters": {
                    "test": "is_difficulty",
                    "value": "easy"
                },
                "add": {
                    "component_groups": [ "wypnt_mss:queen_spider_easy" ]
                }
            },
            {
                "filters": {
                    "test": "is_difficulty",
                    "value": "normal"
                },
                "add": {
                    "component_groups": [ "wypnt_mss:queen_spider_normal" ]
                }
            },
            {
                "filters": {
                    "test": "is_difficulty",
                    "value": "hard"
                },
                "add": {
                    "component_groups": [ "wypnt_mss:queen_spider_hard" ]
                }
            }
        ]
    },
			"wypnt_mss:queen_spider_switch_to_melee": {
    "sequence": [
        {
            // 1. Remove the components from RANGED MODE and add the base components from MELEE MODE.
            "remove": {
                "component_groups": [
                    "wypnt_mss:queen_spider_ranged_mode",
                    "wypnt_mss:queen_spider_easy_ranged_attack",
                    "wypnt_mss:queen_spider_normal_ranged_attack",
                    "wypnt_mss:queen_spider_hard_ranged_attack"
                ]
            },
            "add": {
                "component_groups": [
                    "wypnt_mss:queen_spider_melee_mode" // Base groups (knockback, movement)
                ]
            }
        },
        // 2. Applies the correct Melee combat group, based on the difficulty.
        {
            "filters": { "test": "is_difficulty", "value": "easy" },
            "add": { "component_groups": [ "wypnt_mss:queen_spider_easy_melee_attack" ] }
        },
        {
            "filters": { "test": "is_difficulty", "value": "normal" },
            "add": { "component_groups": [ "wypnt_mss:queen_spider_normal_melee_attack" ] }
        },
        {
            "filters": { "test": "is_difficulty", "value": "hard" },
            "add": { "component_groups": [ "wypnt_mss:queen_spider_hard_melee_attack" ] }
        }
    ]
},
			"wypnt_mss:queen_spider_switch_to_ranged": {
    "sequence": [
        {
            "remove": {
                "component_groups": [
                    "wypnt_mss:queen_spider_melee_mode",
                    "wypnt_mss:queen_spider_easy_melee_attack",
                    "wypnt_mss:queen_spider_normal_melee_attack",
                    "wypnt_mss:queen_spider_hard_melee_attack"
                ]
            },
            "add": {
                "component_groups": [
                    "wypnt_mss:queen_spider_ranged_mode" // Basic groups (shooter, movement, timer)
                ]
            }
        },
        // 2. Applies the correct Ranged Attack group, based on the difficulty.
        {
            "filters": { "test": "is_difficulty", "value": "easy" },
            "add": { "component_groups": [ "wypnt_mss:queen_spider_easy_ranged_attack" ] }
        },
        {
            "filters": { "test": "is_difficulty", "value": "normal" },
            "add": { "component_groups": [ "wypnt_mss:queen_spider_normal_ranged_attack" ] }
        },
        {
            "filters": { "test": "is_difficulty", "value": "hard" },
            "add": { "component_groups": [ "wypnt_mss:queen_spider_hard_ranged_attack" ] }
        }
    ]
},

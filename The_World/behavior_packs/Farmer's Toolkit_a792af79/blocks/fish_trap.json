{
  "format_version": "1.21.40",
  "minecraft:block": {
    "description": {
      "identifier": "fato:fish_trap",
      "menu_category": {
        "category": "none"
      },
      "states": {
        "fato:full": [false, true]
      }
    },
    "components": {
      "minecraft:custom_components": ["fato:fish_trap_behavior"],
      "minecraft:tick": {
        "interval_range": [1200, 1200],
        "looping": true
      },
      "minecraft:geometry": "geometry.fato_fish_trap",

      "minecraft:collision_box": { "origin": [-5, 0, -5], "size": [10, 3, 10] },
      "minecraft:selection_box": { "origin": [-5, 0, -5], "size": [10, 3, 10] },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.5
      },
      "minecraft:loot": "loot_tables/blocks/fish_trap.json",
      "minecraft:material_instances": {
        "*": {
          "texture": "fato_fish_trap_empty",
          "render_method": "alpha_test"
        }
      },
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["up"],
            "block_filter": ["minecraft:water", "minecraft:flowing_water"]
          }
        ]
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('fato:full') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "fato_fish_trap_full",
              "render_method": "alpha_test"
            }
          }
        }
      }
    ]
  }
}

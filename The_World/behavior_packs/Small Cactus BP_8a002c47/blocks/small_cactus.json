{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "smallcactus:small_cactus",
      "menu_category": {
        "category": "nature",
        "group": "minecraft:itemGroup.name.plant"
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:cardinal_direction"
          ],
          "y_rotation_offset": 180
        }
      },
      "states": {
        "smallcactus:above": [
          false,
          true
        ],
        "smallcactus:below": [
          false,
          true
        ]
      }
    },
    "components": {
      "minecraft:geometry": "geometry.small_cactus",
      "minecraft:material_instances": {
        "*": {
          "texture": "small_cactus_side",
          "render_method": "alpha_test"
        },
        "up": {
          "texture": "small_cactus_top",
          "render_method": "alpha_test"
        },
        "down": {
          "texture": "small_cactus_bottom",
          "render_method": "alpha_test"
        }
      },
      "minecraft:collision_box": {
        "origin": [
          -4,
          0,
          -4
        ],
        "size": [
          8,
          7,
          8
        ]
      },
      "minecraft:selection_box": {
        "origin": [
          -4,
          0,
          -4
        ],
        "size": [
          8,
          7,
          8
        ]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.4
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 0.4
      },
      "minecraft:light_dampening": 0,
      "minecraft:map_color": "#4f7a32",
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": [
              "up"
            ],
            "block_filter": [
              "minecraft:sand",
              "minecraft:red_sand",
              "smallcactus:small_cactus"
            ]
          }
        ]
      },
      "minecraft:tick": {
        "interval_range": [
          10,
          15
        ],
        "looping": true
      },
      "smallcactus:stack": {}
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              270,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('smallcactus:above') == true",
        "components": {
          "minecraft:geometry": "geometry.small_cactus_full",
          "minecraft:collision_box": {
            "origin": [
              -4,
              0,
              -4
            ],
            "size": [
              8,
              16,
              8
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -4,
              0,
              -4
            ],
            "size": [
              8,
              16,
              8
            ]
          }
        }
      },
      {
        "condition": "q.block_state('smallcactus:above') == false && q.block_state('smallcactus:below') == true",
        "components": {
          "minecraft:geometry": "geometry.small_cactus_top",
          "minecraft:collision_box": {
            "origin": [
              -4,
              0,
              -4
            ],
            "size": [
              8,
              2,
              8
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -4,
              0,
              -4
            ],
            "size": [
              8,
              2,
              8
            ]
          }
        }
      }
    ]
  }
}

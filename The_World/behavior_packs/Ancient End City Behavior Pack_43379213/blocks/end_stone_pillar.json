{
  "format_version": "1.21.60",
  "minecraft:block": {
    "description": {
      "identifier": "ancientend:end_stone_pillar",
      "menu_category": {
        "category": "construction"
      },
      "traits": {
        "minecraft:placement_position": {
          "enabled_states": [
            "minecraft:block_face"
          ]
        }
      }
    },
    "components": {
      "minecraft:geometry": "minecraft:geometry.full_block",
      "minecraft:material_instances": {
        "*": {
          "texture": "ancientend_end_stone_pillar_side",
          "render_method": "opaque"
        },
        "up": {
          "texture": "ancientend_end_stone_pillar_top",
          "render_method": "opaque"
        },
        "down": {
          "texture": "ancientend_end_stone_pillar_top",
          "render_method": "opaque"
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 3.0
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 9
      },
      "minecraft:map_color": "#EAEEB9",
      "minecraft:collision_box": true,
      "minecraft:selection_box": true,
      "minecraft:friction": 0.4,
      "minecraft:light_dampening": 15,
      "minecraft:redstone_conductivity": {
        "allows_wire_to_step_down": true,
        "redstone_conductor": true
      },
      "minecraft:loot": "loot_tables/blocks/end_stone_pillar.json",
      "tag:minecraft:is_pickaxe_item_destructible": {}
    },
    "permutations": [
      {
        "condition": "query.block_state('minecraft:block_face') == 'east' || query.block_state('minecraft:block_face') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              90
            ]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:block_face') == 'north' || query.block_state('minecraft:block_face') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              90,
              0,
              0
            ]
          }
        }
      }
    ]
  }
}
